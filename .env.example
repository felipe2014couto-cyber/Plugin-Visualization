# Endereco fixo do PI Vision. O proxy nao aceita destinos enviados pelo navegador.
PI_VISION_BASE_URL=http://pimsweb/PIVision

# Conta Windows com permissao de leitura nos Displays que serao importados.
PI_VISION_USER=usuario
PI_VISION_PASSWORD=senha

# Informe o dominio quando PI_VISION_USER nao estiver no formato DOMINIO\usuario
# ou usuario@dominio.
PI_VISION_DOMAIN=DOMINIO

# Porta usada pelo frontend para localizar o proxy.
PIVISION_PROXY_PORT=3001

# Para o Grafana acessado pela rede, use 0.0.0.0. O proxy aceita apenas as
# origens listadas em pi-vision-proxy.js e nao permite destinos arbitrarios.
# Em uma maquina de desenvolvimento sem acesso remoto, use 127.0.0.1.
PIVISION_PROXY_HOST=0.0.0.0
