# Exemplo sem segredos. Injete os valores reais por secret/config store.
SIP_ENV=production
SIP_ORACLE_DSN=host-interno:1521/service_name
SIP_ALLOWED_ORIGINS=https://grafana.exemplo.local

# O backend deve ficar atrás do proxy same-origin /api/sip.
SIP_BIND_HOST=127.0.0.1
SIP_PORT=8085

SIP_DEFAULT_MAX_ROWS=200
SIP_HARD_MAX_ROWS=2000
SIP_MAX_SQL_BYTES=65536
SIP_MAX_COLUMNS=256
SIP_MAX_CELL_BYTES=65536
SIP_MAX_REQUEST_BYTES=1048576
SIP_MAX_RESPONSE_BYTES=8388608
SIP_QUERY_TIMEOUT_MS=30000
SIP_SESSION_IDLE_SECONDS=1800
SIP_SESSION_MAX_SECONDS=28800
SIP_MAX_SESSIONS=100
SIP_RATE_WINDOW_SECONDS=60
SIP_CONNECT_RATE_LIMIT=10
SIP_QUERY_RATE_LIMIT=60
